# OS
.DS_Store

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo / RN (native dirs are generated by prebuild — scope to the RN app only,
# so Flutter's committed android/ios folders are NOT ignored)
.expo/
dist/
web-build/
*.orig.*
apps/customer/ios/
apps/customer/android/

# Flutter build artifacts (its own nested .gitignore also covers these)
apps/customer_flutter/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Native builds / binaries (never commit — large)
*.apk
*.aab
*.ipa
build-*.apk

# Metro / caches
.metro-health-check*
*.tsbuildinfo

# Env & secrets
.env
.env.*
*.keystore
*.jks
google-service-account.json
google-services.json
GoogleService-Info.plist

# Logs
npm-debug.*
yarn-error.*
*.log

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
