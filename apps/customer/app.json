{
  "expo": {
    "name": "DishPop",
    "slug": "customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dishpop-icon.png",
    "scheme": "dishpop",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/dishpop-icon.png",
      "supportsTablet": true
    },
    "android": {
      "package": "com.dishpop.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/images/dishpop-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DishPop uses your location to show the brands, menus and delivery times available in your area."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0E10",
          "image": "./assets/images/dishpop-adaptive.png",
          "imageWidth": 130
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e7aced98-13d1-43cd-ac40-a504a828770f"
      }
    },
    "owner": "ashishsonii"
  }
}
